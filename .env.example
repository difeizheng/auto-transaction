# 环境变量配置示例文件
# 复制此文件为 .env 并修改实际值

# ============ Tushare 配置 ============
TUSHARE_TOKEN=your_tushare_token_here

# ============ 数据库配置 ============
DATABASE_URL=sqlite:///data/quant_trading.db

# ============ 日志配置 ============
LOG_LEVEL=INFO

# ============ 交易模式配置 ============
# true=实盘模式，false=模拟模式
PAPER_TRADING=true
REAL_TRADING_MODE=false

# ============ 实盘券商配置 ============
# 券商类型：huatai(华泰), yinhai(银河), guojin(国金), cicc(中金)
REAL_BROKER_TYPE=huatai
# 券商配置文件路径
REAL_BROKER_CONFIG_PATH=config/broker_config.json

# ============ 数据源配置 ============
# 是否使用实时数据
USE_REALTIME_DATA=true
# 实时数据源：sina(新浪财经), tencent(腾讯财经)
REALTIME_DATA_SOURCE=sina

# ============ 钉钉通知配置 ============
ENABLE_DINGDING_NOTIFY=false
DINGDING_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=your_token
DINGDING_SECRET=your_secret

# ============ 风控配置 ============
MAX_POSITION_RATIO=0.8
STOP_LOSS_RATIO=0.05
TAKE_PROFIT_RATIO=0.15
